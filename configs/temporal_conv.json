{
    "model": {
        "architecture": "temporal_conv",
        "num_wavelength_bins": 51556,
        "n_frames_per_series": 73,
        "num_queries": 16,
        "spectral_latent_dim": 64,
        "metadata_dim": 3,
        "metadata_enc_dim": 16,
        "metadata_enc_hidden": null,
        "param_dim": 20,
        "param_decoder_hidden": null,
        "num_heads": 4,
        "dropout": 0.1,
        "x_encoder_channels": [16, 32, 64, 96, 128],
        "x_encoder_kernel": 7,
        "x_encoder_stride": 2,
        "s_encoder_channels": [16, 32, 64],
        "s_encoder_kernel": 7,
        "s_encoder_stride": 2,
        "encoder_pool_bins": 16,
        "fusion_hidden": 0,
        "fusion_layers": 2
    },
    "training": {
        "optimizer": {
            "optimizer_type": "adamw",
            "learning_rate": 1e-4,
            "weight_decay": 1e-4
        },
        "scheduler": {
            "scheduler_type": "cosine",
            "min_lr": 1e-6
        },
        "max_epochs": 100,
        "gradient_clip_val": 1.0,
        "accumulate_grad_batches": 4,
        "precision": "16-mixed",
        "early_stopping_patience": 15,
        "seed": 42
    }
}
