{
    "model": {
        "architecture": "telluric_estimator",
        "num_wavelength_bins": 51556,
        "num_atm_parameters": 6,
        "fusion_method": "film",
        "n_frames_per_series": 73,
        "num_queries": 16,
        "spectral_latent_dim": 64,
        "spectral_encoder_dims": [2048, 512, 128],
        "metadata_dim": 11,
        "use_time_embed": true,
        "hidden_dim": 256,
        "num_heads": 4,
        "num_layers": 1,
        "dropout": 0.1,
        "predict_spectral_dim": 0
    },
    "training": {
        "optimizer": {
            "optimizer_type": "adamw",
            "learning_rate": 1e-4,
            "weight_decay": 1e-4
        },
        "scheduler": {
            "scheduler_type": "cosine",
            "min_lr": 1e-6
        },
        "max_epochs": 100,
        "gradient_clip_val": 1.0,
        "accumulate_grad_batches": 4,
        "precision": "16-mixed",
        "early_stopping_patience": 15,
        "seed": 42
    }
}
